# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "LaTeX builds, diagnostics and navigation for BBEdit"
description:
  "The bbtex command-line tool behind the bbtex BBEdit package: compiles LaTeX projects, parses logs into BBEdit results, and powers SyncTeX, previews, the project outline and citation/reference pickers."
maintainer: ["Erik Loualiche"]
authors: ["Erik Loualiche"]
license: "MIT"
homepage: "https://github.com/LouLouLibs/bbtex"
bug-reports: "https://github.com/LouLouLibs/bbtex/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "4.14"}
  "uucp" {>= "17.0.0"}
  "uunf" {>= "17.0.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/LouLouLibs/bbtex.git"
